# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Sem esses valores o site roda em
# MODO DEMONSTRAÇÃO, salvando os dados apenas no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
